# Optional LLM API Keys (Gemini, OpenAI, or Groq)
# If no key is provided, the system automatically uses its built-in
# Deterministic Semantic Engine for offline, zero-dependency execution!

# Google Gemini API Key (Recommended)
# GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key
# OPENAI_API_KEY=your_openai_api_key_here

# Groq API Key
# GROQ_API_KEY=your_groq_api_key_here
